import random
import time

class PhilosophicalAI:
    def __init__(self):
        self.name = "الحكيم الصامت"
        self.last_responses = [] # ذاكرة لمنع التكرار المباشر
        self.wisdom_database = {
            ("غرور", "متكبر", "نفسي"): [
