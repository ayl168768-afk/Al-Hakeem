                "العقل عبارة عن حديقة، والأفكار عبارة عن بذور. يمكنك أن تزرع الزهور، أو يمكنك أن تزلع الأعشاب الضارة."
            ]
        }

    def get_response(self, user_input):
        possible_quotes = []
        
        # البحث عن التطابقات وتجميع الخيارات المناسبة
        for keys in self.wisdom_database:
            if any(key in user_input for key in keys):
                possible_quotes.extend(self.wisdom_database[keys])
        
        # إذا لم يجد كلمات مفتاحية، يجمع كل الاقتباسات المتاحة
        if not possible_quotes:
            possible_quotes = [q for sublist in self.wisdom_database.values() for q in sublist]
        
        # استبعاد آخر استجابة لضمان التنوع إن أمكن
        filtered_quotes = [q for q in possible_quotes if q not in self.last_responses]
        if not filtered_quotes: # إذا استُنفدت الخيارات، نعود للمجموعة كاملة
            filtered_quotes = possible_quotes
            
        chosen_quote = random.choice(filtered_quotes)
        
        # تحديث الذاكرة (الاحتفاظ بآخر استجابتين)
        self.last_responses.append(chosen_quote)
        if len(self.last_responses) > 2:
            self.last_responses.pop(0)
            
        return chosen_quote

    def start_session(self):
        print(f"--- مرحباً بك في عيادة {self.name} الفلسفية ---")
        print("تحدث معي عما تشعر به.. (اكتب 'خروج' للإنهاء)")
        
        while True:
            user_text = input("\nأنت: ")
            if user_text.strip() in ['خروج', 'exit', 'quit']:
                print("الحكيم: تذكر دائماً.. اليوم هو هدية، ولهذا يسمى الحاضر. وداعاً.")
                break
            
            print("جاري التفكير في جوهر الحقيقة...", end="\r")
            time.sleep(1.2)
            response = self.get_response(user_text)
            print(f"الحكيم: {response}")

if __name__ == "__main__":
    ai_doctor = PhilosophicalAI()
    ai_doctor.start_session()
